#!/usr/bin/env zsh
#
# Run applications to generate completions fox Zsh.
#
# The file should contain one command per line

set -euo pipefail

. ${0:A:h}/_lib configfile

completion_list="${1:-$HOME/.config/shell-scripts/zsh-completions.txt}"

outdir="$HOME/.zsh-autoload"

function message() {
    echo $@ >&2
}

if [[ ! -f $completion_list ]]; then
    message "No completion found"
    exit 0
fi

if [[ ! -e $outdir ]]; then
    mkdir -p $outdir
fi

typeset -A completions
config_entries $completion_list completions

for cmd in ${(k)completions}; do
    if ! command -v $cmd >/dev/null; then
        message "Executable not found: $cmd"
        continue
    fi
    $cmd ${(s: :)completions[$cmd]} >"$outdir/_$cmd"
done
