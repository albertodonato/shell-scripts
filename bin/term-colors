#!/usr/bin/env bash
# shellcheck disable=SC1117
#
# Print the 256 terminal colors.

set -euo pipefail

declare -A modifiers=(
    [bold]='1'
    [dim]='2'
    [reverse]='3'
    [underline]='4'
)

modifier="${1:-}"
[ -n "$modifier" ] && prefix="${modifiers[$modifier]};" || prefix=""

for i in {0..255}; do
    printf -v code '%03d' "$i"
    printf "\e[%s38;05;%sm" "$prefix" "$code"
    printf "\\\e[%s38;05;%sm" "$prefix" "$code"
    printf '\e[m  '
    [[ $((i % 8)) == 7 ]] && echo
done
